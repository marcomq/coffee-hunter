[application]
config/name="Coffee Hunter: Grounds for Adventure"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/art/branding/icon.svg"
; Kein Godot-Logo beim Start. Die Farbe ist die des Spielhintergrunds
; (RenderingServer.set_default_clear_color in main.gd), damit der Start nicht
; erst grau aufblitzt, bevor der Titel kommt.
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0901961, 0.0666667, 0.0588235, 1)

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[input_devices]

# input_resolver reads Input.get_gravity() for the tilt steering; without this the
# sensor stays off on Android and every call warns instead of returning a reading.
sensors/enable_gravity=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/vram_compression/import_etc2_astc=true

[input]
move_left={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"keycode":4194319)]}
move_right={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"keycode":4194321)]}
move_up={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"keycode":4194320)]}
move_down={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"keycode":4194322)]}
restart={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":82)]}
pause={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":80)]}
confirm={"deadzone": 0.2, "events": [Object(InputEventKey,"keycode":32), Object(InputEventKey,"keycode":4194309)]}
mute={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":77)]}
to_title={"deadzone": 0.2, "events": [Object(InputEventKey,"keycode":4194305)]}
throw={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":70), Object(InputEventKey,"keycode":4194326)]}
